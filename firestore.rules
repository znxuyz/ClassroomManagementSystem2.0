rules_version = '2';

/* ============================================
   Firestore 安全規則
   ────────────────────────────────────────────
   核心原則:
   · 班級資料只有導師本人能寫
   · 學生只能寫自己那份作答,不能改班級、不能改別人的
   · 測驗題目學生只能讀不能寫
   · 名冊索引只讓老師寫,學生讀自己那筆

   部署方式:
     Firebase Console → Firestore Database → 規則 分頁
     把整份內容貼上去,按「發布」
============================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    /* ---------- 使用者檔案 ----------
       role 只能由管理者在 Firebase Console 直接改成 teacher。
       使用者自己寫不了 —— 否則任何人登入後改個欄位就能建班級,
       伺服器負擔與資料風險都是打開的。 */
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // 新帳號一律是學生
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'student';

      // 可以更新暱稱、頭像、登入時間,但 role 必須維持原樣
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    /* 這個人是不是老師。只看 users 文件裡的 role,
       而那個欄位只有 Console 改得動。 */
    function isTeacherAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    /* ---------- 班級 ---------- */
    match /classes/{classId} {

      function isTeacherOfThisClass() {
        return signedIn() && resource.data.teacherUid == request.auth.uid;
      }

      // 學生要讀班級文件才能看到自己的守護獸與積分。
      // 這代表同班同學的積分彼此看得到 —— 對班級經營來說是刻意的,
      // 投影模式本來就是全班一起看。若要完全隱私,需改為每位學生獨立文件。
      allow read: if signedIn();

      // 只有導師本人能改班級資料,學生完全寫不進來
      allow update, delete: if isTeacherOfThisClass();

      // 建立班級:除了 teacherUid 必須是自己,帳號本身也要是老師。
      // 學生登入後就算改了前端程式也建不出班級。
      allow create: if isTeacherAccount()
                    && request.resource.data.teacherUid == request.auth.uid;

      /* 測驗題目:學生只讀,老師才能寫 */
      match /quizzes/{quizId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
      }

      /* 學生自選守護獸:
         文件 id 就是學生的 uid,所以只能寫自己那一份。
         老師端會讀取並收進班級資料(且只填補還沒有守護獸的學生)。 */
      match /petChoices/{uid} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow create, update: if signedIn()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid;
        allow read: if isClassTeacher() || (signedIn() && request.auth.uid == uid);
        allow delete: if isClassTeacher();
      }

      /* 獎品兌換申請:
         學生只能建立自己的申請,而且不能自己決定結果 ——
         status 必須是 pending,實際扣點與核可都在老師端執行。
         建立之後學生就不能再改,避免把 rejected 改回 paid。 */
      match /purchases/{purchaseId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending';
        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow update, delete: if isClassTeacher();
      }

      /* 領地戰的設定與題目:學生只讀不寫。
         answers 這一份含正確答案,學生連讀都不行 ——
         但下面的規則讀得到,用來驗證作答。 */
      match /territory/{docId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        // answers 只有老師讀得到;其餘(config、questions)全班可讀
        allow read: if isClassTeacher() || (signedIn() && docId != 'answers');
        allow write: if isClassTeacher();
      }

      /* 領地戰的作答事件。
         這是整個遊戲唯一的真實來源 —— 地圖是由這些事件重播出來的,
         所以驗證必須在這裡做到位。規則會比對老師設定的正確答案,
         答錯的事件根本寫不進來;組別與佔領分也都從伺服器端的資料核對,
         學生改前端沒有用。寫入後不可修改,免得事後竄改。 */
      /* 作答嘗試:學生「點開題目」的當下就先寫一筆,由伺服器蓋時間。
         這份紀錄解決兩件事 ——
         (1) 文件 id 綁定「誰 + 哪一題」且只能建立不能修改,所以不管重新
             整理幾次,一題就是一次機會。答錯了也用掉,不能再猜。
             (之前答錯不留痕跡,學生重整就能一直猜到對為止。)
         (2) 有了開始時間,下面的 tevents 才能限制「必須在 N 秒內答完」,
             把跑去問 AI 的時間壓掉。
         這裡刻意不驗證答案 —— 對錯是 tevents 的事,嘗試本身一定要留下。 */
      match /tattempts/{attemptId} {
        function cfg() {
          return get(/databases/$(database)/documents/classes/$(classId)/territory/config).data;
        }
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }

        /* 文件 id 是 {uid}_{seq}:seq 是這個學生的第幾筆嘗試。
           同一題可以再試 —— 再試就是新的 seq,題庫小的班級不會因為
           答錯幾題就無題可答。防刷分靠的是另外兩件事:
           tevents 的 id 仍然是 {uid}_{題號},同一題只能「答對」一次;
           以及答錯會倒扣。

           seq 放進 id 裡還有一個用途:id 唯一 + 不准修改,等於
           同一個 seq 只能存在一份,一個學生的嘗試就被迫接成一條
           不能分岔、不能跳號的鏈。連錯冷卻就是靠這條鏈擋的。 */
        function prevDoc() {
          return get(/databases/$(database)/documents/classes/$(classId)/tattempts/$(request.resource.data.prev)).data;
        }
        /* 上一筆答對了嗎 —— 答對會留下 tevents/{uid}_{題號},
           那份文件只有答對才寫得進來,學生偽造不了。 */
        function prevSolved() {
          return exists(/databases/$(database)/documents/classes/$(classId)/tevents/$(request.auth.uid + '_' + prevDoc().questionId));
        }
        /* 這一筆是不是「換題」。換題的定義很窄:接在自己的前一筆之後、
           打同一格、而且前一筆還沒答對 —— 否則就只是一筆新的嘗試。
           這個判定必須嚴,因為換題不算答錯:放寬的話學生只要每一筆都
           宣稱自己在換題,連錯冷卻和答錯倒扣就都失效了。
           換題次數另外由 maxSwaps 封頂(見下面),所以就算全用來換題,
           一次攻擊最多也只能凍結那幾筆。 */
        function isSwap() {
          return request.resource.data.get('replaces', '') != ''
            && request.resource.data.get('replaces', '') == request.resource.data.prev
            && prevDoc().hexKey == request.resource.data.hexKey
            && !prevSolved();
        }
        /* 這一筆該帶的連錯數。前端用同一套算式顯示倒數(見 Territory.nextStreak) */
        function wantStreak() {
          return isSwap()
                   ? prevDoc().get('streak', 0)                 // 換題不算答錯
                   : (prevSolved() ? 0 : prevDoc().get('streak', 0) + 1);
        }
        /* 這一次攻擊已經換過幾次題。換題累加,新的攻擊歸零 */
        function wantSwaps() {
          return isSwap() ? prevDoc().get('swaps', 0) + 1 : 0;
        }
        function coolN() { return cfg().get('cooldownWrong', 0); }
        function coolSec() { return cfg().get('cooldownSeconds', 0); }

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && attemptId == request.auth.uid + '_' + string(request.resource.data.seq)
          && request.resource.data.at == request.time
          && request.resource.data.groupIdx == cfg().memberGroup[request.resource.data.studentId]
          && cfg().status == 'running'
          // 老師關掉冷卻(連錯題數或秒數設 0)就不檢查這條鏈
          && (
               coolN() <= 0 || coolSec() <= 0
               || (
                    /* 鏈必須是連號的:第 n 筆的前一筆只能是 {uid}_{n-1}。
                       不准跳號,所以「把 prev 填空、假裝自己是第一筆」
                       這招只有在真的第一筆(seq=1)時才成立,
                       而 {uid}_1 這個 id 一輩子只能被建立一次。 */
                    request.resource.data.seq == 1
                      ? (request.resource.data.prev == ''
                           && request.resource.data.streak == 0
                           && request.resource.data.get('swaps', 0) == 0)
                      : (
                          request.resource.data.seq > 1
                          && request.resource.data.prev
                             == request.auth.uid + '_' + string(request.resource.data.seq - 1)
                          && exists(/databases/$(database)/documents/classes/$(classId)/tattempts/$(request.resource.data.prev))
                          // 連錯數不能自己填,由上一筆的結果推出來
                          && request.resource.data.streak == wantStreak()
                          // 換題次數也不能自己填,而且不能超過老師設的上限
                          && request.resource.data.get('swaps', 0) == wantSwaps()
                          && request.resource.data.get('swaps', 0) <= cfg().get('maxSwaps', 3)
                          // 連錯數踩到倍數就得等滿冷卻時間
                          && (
                               request.resource.data.streak == 0
                               || request.resource.data.streak % coolN() != 0
                               || request.time >= prevDoc().at + duration.value(coolSec(), 's')
                             )
                        )
                  )
             );

        // 裡面只有題號與時間,沒有答案,全班可讀不會洩題
        allow read: if signedIn();
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      /* 失手回報:學生答錯/超時/作廢/放棄的當下自己寫一筆,
         文件 id 就是那次嘗試的 id。有了它,倒扣才會發生在「真正答錯的
         那一刻、他正在打的那一格」,而不是等期限到了才一起浮現 ——
         否則讀題慢的學生還在想,那一格就先被扣,老師看起來就像
         好幾塊正在進攻的地同時被扣分。

         這裡不需要防「少寫」:想躲倒扣的人本來就不會寫,重播有期限兜底。
         要防的是「亂寫」—— 所以限定只能回報自己的嘗試,一筆只能寫一次。 */
      match /tfails/{attemptId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        function attempt() {
          return get(/databases/$(database)/documents/classes/$(classId)/tattempts/$(attemptId)).data;
        }

        allow create: if signedIn()
          // 那筆嘗試要真的存在
          && exists(/databases/$(database)/documents/classes/$(classId)/tattempts/$(attemptId))
          // 回報的人要嘛是本人,要嘛是導師。
          // 導師那一台負責補寫「點開題目就關掉分頁、沒人回報」的那幾筆 ——
          // 有了這個,學生端就不必再讀整份嘗試紀錄(那是最大的一份集合)。
          && request.resource.data.uid == attempt().uid
          && (attempt().uid == request.auth.uid || isClassTeacher())
          // 扣在哪一格由那筆嘗試決定,不能自己挑別人的地來扣
          && request.resource.data.hexKey == attempt().hexKey
          && request.resource.data.groupIdx == attempt().groupIdx
          // 時間戳一律用伺服器的
          && request.resource.data.at == request.time;

        allow read: if signedIn();
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      match /tevents/{eventId} {
        function cfg() {
          return get(/databases/$(database)/documents/classes/$(classId)/territory/config).data;
        }
        function answerKey() {
          return get(/databases/$(database)/documents/classes/$(classId)/territory/answers).data.key;
        }
        function q() {
          return answerKey()[request.resource.data.questionId];
        }
        function attempt() {
          return get(/databases/$(database)/documents/classes/$(classId)/tattempts/$(request.resource.data.attemptId)).data;
        }
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          // 文件 id 綁定「誰 + 哪一題」,所以同一題每人只能「答對」一次。
          // 加上 update 一律禁止,背下答案也無法重複刷分。
          // (答錯則可以再試,見 tattempts)
          && eventId == request.auth.uid + '_' + request.resource.data.questionId
          // 遊戲要在進行中
          && cfg().status == 'running'
          // 題目必須存在,而且答案要正確
          && request.resource.data.questionId in answerKey()
          && request.resource.data.answer == q().a
          // 佔領分由題目難度決定,不能自己填
          && request.resource.data.points == q().p
          // 組別以老師的分組為準
          && request.resource.data.groupIdx == cfg().memberGroup[request.resource.data.studentId]
          // 時間戳一律用伺服器的,先後才不受學生裝置時鐘影響
          && request.resource.data.at == request.time
          // 必須指向一筆自己的、同一題的「點開題目」紀錄
          && exists(/databases/$(database)/documents/classes/$(classId)/tattempts/$(request.resource.data.attemptId))
          && attempt().uid == request.auth.uid
          && attempt().questionId == request.resource.data.questionId
          // 老師有設時限才檢查。設 0 代表不限時(有些學生讀題慢)。
          && (
               (('answerSeconds' in cfg()) ? cfg().answerSeconds : 0) <= 0
               || request.time < attempt().at + duration.value(cfg().answerSeconds, 's')
             );

        allow read: if signedIn();
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      /* 學生作答:
         · 學生只能建立/修改 id 為 {quizId}__{自己的uid} 的那一份
         · 而且文件裡的 uid 欄位必須等於自己,不能偽造成別人
         · 老師可以讀全部(要批改),但不能代寫 */
      /* 每日備份:只有導師看得到、寫得了。
         學生完全碰不到,也不需要 —— 這是給老師救資料用的。 */
      match /backups/{backupId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow read, write: if isClassTeacher();
      }

      /* 逐題搶答:一題一份文件,只能建立不能修改。
         · 文件 id 綁定「哪份測驗 + 誰 + 哪一題」,所以同一題只能答一次
         · 時間戳必須是伺服器時間,學生無法把自己的作答時間改早
         · 測驗要在開放中
         正確與否不在這裡判斷 —— 答案留在老師手上,結算時才批改,
         所以規則不需要、也不會碰到正確答案。 */
      match /qanswers/{ansId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        function quizOpen() {
          return get(/databases/$(database)/documents/classes/$(classId)/quizzes/$(request.resource.data.quizId)).data.status == 'open';
        }

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && ansId == request.resource.data.quizId + '__' + request.auth.uid
                      + '__' + request.resource.data.questionId
          && request.resource.data.at == request.time
          && quizOpen();

        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      match /submissions/{subId} {
        function isMine() {
          return signedIn()
                 && request.resource.data.uid == request.auth.uid
                 && subId.matches('.*__' + request.auth.uid);
        }
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }

        allow create, update: if isMine();
        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isClassTeacher();
      }
    }

    /* ---------- 名冊索引 ----------
       學生用 email 查自己屬於哪些班。
       只允許讀自己那一筆,不能拿去掃描全校名單。
       寫入開放給已登入者,是因為規則層無法得知寫入者是不是
       某個班的導師(文件 id 是學生 email,不含班級資訊)。
       實務上這是可接受的取捨:寫入者必須先知道對方 email,
       且寫錯只會導致學生看到不存在的班級,讀不到任何資料 ——
       真正的資料防線在上面的 classes 規則。 */
    match /rosterIndex/{emailKey} {
      allow read:  if signedIn() && emailKey == myEmail();
      allow write: if signedIn();
    }
  }
}
